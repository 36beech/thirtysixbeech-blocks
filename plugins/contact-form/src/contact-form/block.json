{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "thirtysixbeech-blocks/contact-form",
	"version": "0.1.0",
	"title": "Contact Form",
	"category": "thirtysixbeech-content",
	"icon": "smiley",
	"description": "A simple Wordpress contact form",
	"example": {},
	"supports": {
		"html": false,
		"spacing": {
			"padding": false,
			"margin": ["top", "bottom"],
			"units": ["px", "em", "rem"],
			"layout": true,
			"blockGap": ["horizontal", "vertical"]
		}
	},
	"attributes": {
		"toAddress": {
			"type": "string"
		}
	},
	"textdomain": "contact-form",
	"editorScript": "file:./index.js",
	"editorStyle": "file:../assets/css/editor.css",
	"style": "file:../assets/css/main.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
