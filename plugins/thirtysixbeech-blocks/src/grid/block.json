{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "thirtysixbeech-blocks/grid",
	"version": "0.1.0",
	"title": "Grid",
	"category": "thirtysixbeech-layout",
	"icon": "smiley",
	"description": "Example block scaffolded with Create Block tool.",
	"example": {},
	"supports": {
		"html": false,
		"spacing": {
			"padding": false,
			"margin": ["top", "bottom"],
			"units": ["px", "em", "rem"],
			"layout": true,
			"blockGap": ["horizontal", "vertical"]
		}
	},
	"attributes": {
		"layout": {
			"type": "object",
			"default": {
				"type": "grid"
			}
		},
		"breakpoint": {
			"type": "string",
			"default": "tablet"
		},
		"reverse": {
			"type": "boolean",
			"default": false
		},
		"alignItems": {
			"type": "string",
			"default": "tsb-a-start"
		}
	},
	"textdomain": "grid",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
