{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "thirtysixbeech-blocks/card-product",
	"version": "0.1.0",
	"title": "Product Card",
	"category": "thirtysixbeech-content",
	"icon": "smiley",
	"description": "Example block scaffolded with Create Block tool.",
	"example": {},
	"attributes": {
		"imageId": {
			"type": "number"
		},
		"productTag": {
			"type": "string",
			"default": ""
		},
		"productTitle": {
			"type": "string",
			"default": ""
		},
		"productDescription": {
			"type": "string",
			"default": ""
		},
		"imagePadding": {
			"type": "number",
			"default": 72
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"gradients": true,
			"link": false,
			"text": true
		},
		"spacing": {
			"padding": ["top", "bottom"],
			"margin": ["top", "bottom"],
			"units": ["px", "em", "rem"]
		},
		"shadow": true
	},
	"usesContext": ["thirtysixbeech/blockGap", "thirtysixbeech/evenColumns"],
	"textdomain": "card-product",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
