{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "thirtysixbeech-blocks/product-hero",
	"version": "0.1.0",
	"title": "Product Hero",
	"category": "thirtysixbeech-content",
	"icon": "smiley",
	"description": "Example block scaffolded with Create Block tool.",
	"example": {},
	"supports": {
		"html": false
	},
	"attributes": {
		"imageId": {
			"type": "number"
		},
		"productTag": {
			"type": "string",
			"default": ""
		},
		"productTitle": {
			"type": "string",
			"default": ""
		},
		"productDescription": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "product-hero",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
